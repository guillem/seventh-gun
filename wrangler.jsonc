{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seventh-gun",
  "main": "./server/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* is answered by server/api.ts, not by a static file. Only the three
    // JSON endpoints are listed: /api/ is the HTML documentation page and must
    // keep coming from assets. Adding a route to API_ROUTES means adding it
    // here too, or it will silently 404 as a missing asset.
    "run_worker_first": ["/arena", "/health", "/api/maze", "/api/maps", "/api/share"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ARENA", "class_name": "ArenaRoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaRoomDO"] }],
  "vars": { "ALLOWED_ORIGINS": "" },
  "observability": { "enabled": true }
}
