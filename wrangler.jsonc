{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // BRANCH-ONLY (codex/experimental-modern-art, never merged): a separate
  // Worker with its own Durable Object room, so nothing deployed from this
  // branch can replace production `seventh-gun` or join its arena. Keep ONLY
  // art.seventhgun.com below; wrangler takes over a domain from another Worker
  // without asking when it runs non-interactively. workers_dev must stay true:
  // listing a domain turns the workers.dev URL off by default.
  "name": "seventh-gun-art",
  "routes": [{ "pattern": "art.seventhgun.com", "custom_domain": true }],
  "workers_dev": true,
  "main": "./server/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/arena", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ARENA", "class_name": "ArenaRoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaRoomDO"] }],
  "vars": { "ALLOWED_ORIGINS": "" },
  "observability": { "enabled": true }
}
