{
  "name": "seventh-gun",
  "version": "0.1.0",
  "description": "A seeded, late-1990s-style first-person shooter with generated mazes and assets, seven authored campaign maps, and an optional self-hosted arena.",
  "license": "MIT",
  "author": "Guillem Cantallops Ramis",
  "homepage": "https://github.com/guillem/seventh-gun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillem/seventh-gun.git"
  },
  "bugs": {
    "url": "https://github.com/guillem/seventh-gun/issues"
  },
  "keywords": [
    "fps",
    "game",
    "three.js",
    "webgl",
    "procedural",
    "roguelike",
    "self-hosted",
    "multiplayer"
  ],
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "seventh-gun": "./bin/seventh-gun.mjs"
  },
  "files": [
    "bin",
    "dist/client",
    "dist/node",
    "LICENSE",
    "README.md",
    "THIRD-PARTY.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:portable": "vite build --mode portable",
    "build:server": "vite build --mode portable --ssr server/node/main.ts",
    "build:dist": "npm run typecheck && npm run build:portable && npm run build:server",
    "start": "node bin/seventh-gun.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.node.json",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.18.1",
    "three": "^0.171.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.128.0"
  }
}
